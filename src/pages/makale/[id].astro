---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const blogEntries = await getCollection('blog', ({ data }) => !data.draft);
    return blogEntries.map((entry, index) => {
        const prevPost = index > 0 ? blogEntries[index - 1] : null;
        const nextPost = index < blogEntries.length - 1 ? blogEntries[index + 1] : null;
        return {
            params: { id: entry.id }, 
            props: { entry, prevPost, nextPost },
        };
    });
}

const { entry, prevPost, nextPost } = Astro.props;
const { Content } = await render(entry);

const wordCount = entry.body ? entry.body.split(/\s+/).length : 500;
const readTimeMinutes = Math.max(2, Math.ceil(wordCount / 180));

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<Layout title={`${entry.data.title} | Ata Yiğit Telli`} activePage="blog" description={entry.data.excerpt}>
    <main>
        <section class="section section-padding" style="margin-top: 5rem; min-height: 80vh;">
            <div class="container" style="max-width: 800px;">
                <!-- Article Header -->
                <div class="article-detail-header" style="margin-bottom: 2.5rem; text-align: center;">
                    <a href={`${base}blog/`} class="back-to-blog" style="display: inline-flex; align-items: center; gap: 0.5rem; color: var(--accent-color); font-size: 0.9rem; text-decoration: none; margin-bottom: 1.5rem; font-weight: 600; transition: var(--transition-fast);" id="backBtn">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        Bloga Geri Dön
                    </a>
                    
                    <div style="margin-bottom: 0.5rem;">
                        <span class="blog-card-tag" style="position: static; font-size: 0.75rem;">{entry.data.category}</span>
                    </div>
                    
                    <h1 class="article-title-text" style="font-size: 2.2rem; font-weight: 800; color: var(--text-primary); line-height: 1.3; margin: 1rem 0;">{entry.data.title}</h1>
                    
                    <div class="article-meta-info" style="font-size: 0.85rem; color: var(--text-muted); display: flex; align-items: center; justify-content: center; gap: 1rem;">
                        <span>Yayınlanma: {entry.data.date}</span>
                        <span>•</span>
                        <span>⏱️ {readTimeMinutes} dk okuma</span>
                    </div>
                </div>

                {entry.data.imageUrl && (
                    <div class="article-detail-hero" style="border: 1px solid var(--border-color); border-radius: var(--border-radius-md); overflow: hidden; margin-bottom: 2.5rem; height: 350px; background-color: var(--bg-secondary);">
                        <img src={`${base}${entry.data.imageUrl}`} alt={entry.data.title} style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                )}

                <!-- Article Body (Markdown Content) -->
                <div class="article-body-content" id="articleBody">
                    <Content />
                </div>

                <!-- Social Share Toolbar -->
                <div class="share-buttons-group" style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
                    <span style="font-weight: 700; font-size: 0.9rem; color: var(--text-primary);">Bu Makaleyi Paylaş:</span>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <button type="button" class="btn btn-secondary btn-share-link" id="shareLinkedIn" style="padding: 0.4rem 0.85rem; font-size: 0.8rem; cursor: pointer;">
                            LinkedIn
                        </button>
                        <button type="button" class="btn btn-secondary btn-share-link" id="shareTwitter" style="padding: 0.4rem 0.85rem; font-size: 0.8rem; cursor: pointer;">
                            X (Twitter)
                        </button>
                        <button type="button" class="btn btn-secondary btn-share-link" id="shareWhatsApp" style="padding: 0.4rem 0.85rem; font-size: 0.8rem; cursor: pointer;">
                            WhatsApp
                        </button>
                        <button type="button" class="btn btn-secondary btn-share-link" id="copyLinkBtn" style="padding: 0.4rem 0.85rem; font-size: 0.8rem; cursor: pointer;">
                            🔗 Bağlantıyı Kopyala
                        </button>
                    </div>
                </div>

                <!-- Prev / Next Article Navigation -->
                <div class="article-nav-footer" style="margin-top: 3rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
                    {prevPost ? (
                        <a href={`${base}makale/${prevPost.id}/`} class="sim-glass-card" style="text-decoration: none; padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.35rem; border-radius: var(--border-radius-md);">
                            <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">← ÖNCEKİ MAKALEM</span>
                            <span style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); line-height: 1.3;">{prevPost.data.title}</span>
                        </a>
                    ) : <div></div>}

                    {nextPost ? (
                        <a href={`${base}makale/${nextPost.id}/`} class="sim-glass-card" style="text-decoration: none; padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.35rem; border-radius: var(--border-radius-md); text-align: right;">
                            <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">SONRAKİ MAKALEM →</span>
                            <span style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); line-height: 1.3;">{nextPost.data.title}</span>
                        </a>
                    ) : <div></div>}
                </div>
            </div>
        </section>
    </main>
</Layout>

<script is:inline>
    (function() {
        const pageUrl = window.location.href;
        const pageTitle = document.title;

        document.getElementById('shareLinkedIn')?.addEventListener('click', () => {
            window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`, '_blank');
        });

        document.getElementById('shareTwitter')?.addEventListener('click', () => {
            window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(pageTitle)}`, '_blank');
        });

        document.getElementById('shareWhatsApp')?.addEventListener('click', () => {
            window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(pageTitle + ' ' + pageUrl)}`, '_blank');
        });

        document.getElementById('copyLinkBtn')?.addEventListener('click', () => {
            navigator.clipboard.writeText(pageUrl).then(() => {
                if (typeof window.showToast === 'function') {
                    window.showToast("Bağlantı Kopyalandı", "Makale bağlantısı panoya kopyalandı.");
                } else {
                    alert("Makale bağlantısı kopyalandı!");
                }
            });
        });

        // --- IN-ARTICLE PAINT CALCULATOR WIDGET LOGIC ---
        function calcPaintRequirements() {
            const lenEl = document.getElementById('inpPaintRoomLen');
            const widEl = document.getElementById('inpPaintRoomWidth');
            if (!lenEl || !widEl) return;

            const len = parseFloat(lenEl.value) || 6.0;
            const wid = parseFloat(widEl.value) || 4.0;
            const hght = parseFloat(document.getElementById('inpPaintRoomHeight')?.value || '2.8') || 2.8;
            const open = parseFloat(document.getElementById('inpPaintOpenings')?.value || '6.0') || 0;
            const stype = document.getElementById('inpPaintSurfaceType')?.value || 'alci';
            const coats = parseInt(document.getElementById('inpPaintCoats')?.value || '2') || 2;

            const grossWallArea = 2 * (len + wid) * hght;
            const netWallArea = Math.max(5, grossWallArea - open);
            const ceilingArea = len * wid;

            let primerCoverageM2Ltr = 12;
            if (stype === 'alci') primerCoverageM2Ltr = 10;
            else if (stype === 'brut') primerCoverageM2Ltr = 8;
            else if (stype === 'eski') primerCoverageM2Ltr = 14;

            const primerLtr = netWallArea / primerCoverageM2Ltr;
            let paintCoverageM2LtrPerCoat = 14;
            const paintLtr = (netWallArea * coats) / paintCoverageM2LtrPerCoat;
            const ceilingLtr = (ceilingArea * 2) / 13;

            const getBucketText = (ltr) => {
                if (ltr <= 2.5) return `${ltr.toFixed(1)} Lt (2.5L Ambalaj)`;
                if (ltr <= 7.5) return `${ltr.toFixed(1)} Lt (7.5L Kova)`;
                if (ltr <= 15) return `${ltr.toFixed(1)} Lt (15L Kova)`;
                const buckets = Math.ceil(ltr / 15);
                return `${ltr.toFixed(1)} Lt (${buckets} Adet 15L Kova)`;
            };

            const setVal = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.innerText = val;
            };

            setVal('outNetWallArea', `${netWallArea.toFixed(1)} m²`);
            setVal('outCeilingArea', `${ceilingArea.toFixed(1)} m²`);
            setVal('outPrimerLtr', getBucketText(primerLtr));
            setVal('outPaintLtr', getBucketText(paintLtr));
            setVal('outCeilingLtr', getBucketText(ceilingLtr));
        }

        ['inpPaintRoomLen', 'inpPaintRoomWidth', 'inpPaintRoomHeight', 'inpPaintOpenings', 'inpPaintSurfaceType', 'inpPaintCoats'].forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('input', calcPaintRequirements);
                el.addEventListener('change', calcPaintRequirements);
                el.addEventListener('keyup', calcPaintRequirements);
            }
        });

        document.getElementById('btnCalcPaintWidget')?.addEventListener('click', () => {
            calcPaintRequirements();
            if (typeof window.showToast === 'function') {
                window.showToast("Hesaplama Yapıldı", "Boya ve astar ihtiyacı güncellendi.");
            }
        });

        calcPaintRequirements();
        setTimeout(calcPaintRequirements, 300);
        window.addEventListener('load', calcPaintRequirements);
    })();
</script>

<style is:global>
    /* Styling elements inside the Markdown container */
    .article-body-content {
        font-size: 1.05rem;
        line-height: 1.75;
        color: var(--text-secondary);
    }
    .article-body-content p {
        margin-bottom: 1.5rem;
    }
    .article-body-content h4 {
        color: var(--text-primary);
        font-weight: 700;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
    }
    .article-body-content ul {
        margin-left: 1.5rem;
        margin-bottom: 1.5rem;
        list-style-type: square;
    }
    .article-body-content li {
        margin-bottom: 0.5rem;
    }
    .back-to-blog:hover {
        transform: translateX(-4px);
        color: var(--text-primary);
    }
</style>
