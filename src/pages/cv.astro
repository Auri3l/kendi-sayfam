---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<Layout title="Özgeçmiş (CV) | Ata Yiğit Telli" activePage="cv" description="Ata Yiğit Telli - İnşaat Mühendisi & Proje Yöneticisi Profesyonel Tek Sayfa Özgeçmiş (CV).">
    <main>
        <div class="cv-page-wrapper">
            <!-- Top Controls Toolbar (Hidden in Print) -->
            <div class="cv-toolbar no-print">
                <div class="cv-toolbar-container">
                    <a href={base} class="btn btn-secondary btn-sm cv-back-btn">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        Ana Sayfaya Dön
                    </a>

                    <div class="cv-toolbar-actions">
                        <span class="cv-format-badge">Tek Sayfa Standart CV</span>
                        <button type="button" class="btn btn-primary btn-sm" id="btnPrintCv" style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                <rect x="6" y="14" width="12" height="8"></rect>
                            </svg>
                            Tek Sayfa PDF Olarak Kaydet / Yazdır
                        </button>
                    </div>
                </div>
            </div>

            <!-- Standard Single-Page CV Sheet Container -->
            <div class="standard-cv-paper" id="standardCvPaper">
                <!-- Header: Name & Contact Information (Centered) -->
                <header class="hcv-header">
                    <h1 class="hcv-name">ATA YİĞİT TELLİ</h1>
                    <p class="hcv-title">İnşaat Mühendisi &amp; Proje Yöneticisi</p>
                    <div class="hcv-contact-line">
                        <span>İstanbul, Türkiye</span>
                        <span class="hcv-sep">•</span>
                        <span id="cvPhoneSlot" class="protected-slot">
                            <button type="button" class="protected-trigger-btn hcv-link" data-action="unlockContact" title="Telefon Numarasını Aç">
                                🔒 •••••••••• (Şifreli)
                            </button>
                        </span>
                        <span class="hcv-sep">•</span>
                        <a href="mailto:ytelli@gmail.com" class="hcv-link">ytelli@gmail.com</a>
                        <span class="hcv-sep">•</span>
                        <a href="https://www.linkedin.com/in/ay-t" target="_blank" rel="noopener noreferrer" class="hcv-link">linkedin.com/in/ay-t</a>
                    </div>
                </header>

                <!-- 1. EDUCATION (EĞİTİM) -->
                <section class="hcv-section">
                    <h2 class="hcv-section-title">EĞİTİM</h2>
                    
                    <div class="hcv-entry">
                        <div class="hcv-entry-row">
                            <span class="hcv-bold">İSTANBUL GEDİK ÜNİVERSİTESİ</span>
                            <span class="hcv-right">2017 – 2018</span>
                        </div>
                        <div class="hcv-entry-row">
                            <span class="hcv-italic">Yüksek Lisans: İş Sağlığı ve Güvenliği</span>
                            <span class="hcv-right hcv-muted">İstanbul, Türkiye</span>
                        </div>
                    </div>

                    <div class="hcv-entry">
                        <div class="hcv-entry-row">
                            <span class="hcv-bold">OKAN ÜNİVERSİTESİ</span>
                            <span class="hcv-right">2011 – 2015</span>
                        </div>
                        <div class="hcv-entry-row">
                            <span class="hcv-italic">Lisans: İnşaat Mühendisliği (%100 İngilizce)</span>
                            <span class="hcv-right hcv-muted">İstanbul, Türkiye</span>
                        </div>
                    </div>
                </section>

                <!-- 2. PROFESSIONAL EXPERIENCE (MESLEKİ DENEYİM) -->
                <section class="hcv-section">
                    <h2 class="hcv-section-title">MESLEKİ DENEYİM</h2>

                    <!-- Experience 1 -->
                    <div class="hcv-entry">
                        <div class="hcv-entry-row">
                            <span class="hcv-bold">TRENDWORLD MİMARLIK</span>
                            <span class="hcv-right">Haziran 2026 – Devam</span>
                        </div>
                        <div class="hcv-entry-row">
                            <span class="hcv-italic">İnşaat Mühendisi / Saha Sorumlusu</span>
                            <span class="hcv-right hcv-muted">İstanbul, Türkiye</span>
                        </div>
                        <ul class="hcv-bullets">
                            <li>Ana müteahhit şantiye standartları doğrultusunda taşeron saha operasyonları ve ekiplerin sevk-idaresinin yürütülmesi.</li>
                            <li>İş programı entegrasyonu, İSG kuralları, kalite kontrol ve taşeron hakediş-sözleşme süreçlerinin takibi.</li>
                        </ul>
                    </div>

                    <!-- Experience 2 -->
                    <div class="hcv-entry">
                        <div class="hcv-entry-row">
                            <span class="hcv-bold">AA&amp;TD BUILDING SOLUTIONS (NCC PROJESİ)</span>
                            <span class="hcv-right">Aralık 2023 – Mart 2026</span>
                        </div>
                        <div class="hcv-entry-row">
                            <span class="hcv-italic">İnşaat Mühendisi / Teknik Ofis &amp; Proje Şefi</span>
                            <span class="hcv-right hcv-muted">İstanbul, Türkiye</span>
                        </div>
                        <ul class="hcv-bullets">
                            <li>Üstyapı projelerinde taşeron sözleşme yönetimi, teknik ofis süreçleri, hakediş-metraj analizleri ve saha koordinasyonu.</li>
                            <li>Mimari uygulama detaylarının denetimi, revizyon yönetimi, bütçe takibi ve periyodik ilerleme raporlaması.</li>
                        </ul>
                    </div>

                    <!-- Experience 3 -->
                    <div class="hcv-entry">
                        <div class="hcv-entry-row">
                            <span class="hcv-bold">METAL YAPI</span>
                            <span class="hcv-right">Ekim 2016 – Temmuz 2023</span>
                        </div>
                        <div class="hcv-entry-row">
                            <span class="hcv-italic">Proje Yöneticisi / İnşaat Mühendisi (Associate PM / Assistant PM / Civil Engineer)</span>
                            <span class="hcv-right hcv-muted">İstanbul &amp; New York, ABD</span>
                        </div>
                        <ul class="hcv-bullets">
                            <li>New York kule projelerinde (One Madison Ave., One Willoughby Sq.) cephe imalat ve tasarım koordinasyonunun Türkiye'den yönetimi.</li>
                            <li>Ana müteahhitler (Turner, Gilbane) ile teknik ve sözleşmesel süreçlerin takibi; BIM platformlarında 3D çakışma koordinasyonu.</li>
                        </ul>
                    </div>

                    <!-- Experience 4 -->
                    <div class="hcv-entry">
                        <div class="hcv-entry-row">
                            <span class="hcv-bold">İSTANBUL MCE YAPI DENETİM LTD. ŞTİ.</span>
                            <span class="hcv-right">Şubat 2016 – Mayıs 2016</span>
                        </div>
                        <div class="hcv-entry-row">
                            <span class="hcv-italic">Saha Denetçisi / Yapı Denetim Mühendisi</span>
                            <span class="hcv-right hcv-muted">İstanbul, Türkiye</span>
                        </div>
                        <ul class="hcv-bullets">
                            <li>5000 m² üzeri taahhütlerde betonarme demir donatı ve beton döküm denetimleri; TS 500 ve resmi yapı denetim raporlaması.</li>
                        </ul>
                    </div>

                    <!-- Experience 5 -->
                    <div class="hcv-entry">
                        <div class="hcv-entry-row">
                            <span class="hcv-bold">ÖMAY YAPI</span>
                            <span class="hcv-right">Ekim 2015 – Aralık 2015</span>
                        </div>
                        <div class="hcv-entry-row">
                            <span class="hcv-italic">Şantiye Şefi / Saha Mühendisi</span>
                            <span class="hcv-right hcv-muted">İstanbul, Türkiye</span>
                        </div>
                        <ul class="hcv-bullets">
                            <li>Ümraniye-Üsküdar metro hattı Çakmak İstasyonu tünel kalıp ve peron betonarmesi kaba işlerinin saha yönetimi.</li>
                        </ul>
                    </div>
                </section>

                <!-- 3. SELECTED PROJECTS (SEÇİLMİŞ PROJELER) -->
                <section class="hcv-section">
                    <h2 class="hcv-section-title">SEÇİLMİŞ PROJELER</h2>
                    <div class="hcv-projects-compact">
                        <p><strong class="hcv-bold">One Madison Avenue (New York, ABD):</strong> Unitized Panel Cephe sistemlerinin tasarım ve fabrika imalat koordinasyonu.</p>
                        <p><strong class="hcv-bold">One Willoughby Square (Brooklyn, NY):</strong> Yüksek yapı panel cephe ve endüstriyel doğrama imalat takibi ve onay süreçleri.</p>
                        <p><strong class="hcv-bold">Başarı Holding Genel Müdürlük (İstanbul):</strong> Spider cam cephe ve kompozit kaplama imalat-montaj yönetimi.</p>
                        <p><strong class="hcv-bold">Maltepe Piazza (İstanbul):</strong> AVM ve kule projesinde alüminyum giydirme cephe, skylight ve kanopi imalat koordinasyonu.</p>
                    </div>
                </section>

                <!-- 4. SKILLS & COMPETENCIES (YETKİNLİKLER VE DİLLER) -->
                <section class="hcv-section">
                    <h2 class="hcv-section-title">YETKİNLİKLER &amp; DİLLER</h2>
                    <div class="hcv-skills-grid">
                        <p><strong class="hcv-bold">Teknik Uzmanlık:</strong> Şantiye &amp; Saha Yönetimi, Sözleşme Yönetimi (FIDIC), Hak Ediş &amp; Metraj Analizi, Kalite Kontrol (TS 500, EN 13830), İSG.</p>
                        <p><strong class="hcv-bold">Yazılım &amp; Araçlar:</strong> BIM (Autodesk Revit, Navisworks), AutoCAD, MS Project, Microsoft Office (İleri Düzey Excel &amp; Raporlama).</p>
                        <p><strong class="hcv-bold">Diller:</strong> Türkçe (Anadil), İngilizce (Tam Profesyonel / Akıcı), Almanca, Rusça, Fransızca, İspanyolca.</p>
                    </div>
                </section>
            </div>
        </div>
    </main>
</Layout>

<script is:inline>
    document.getElementById('btnPrintCv')?.addEventListener('click', () => {
        window.print();
    });
</script>

<style>
    .cv-page-wrapper {
        min-height: 100vh;
        background-color: var(--bg-primary);
        padding: 5.5rem 1rem 3rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Top Toolbar */
    .cv-toolbar {
        width: 100%;
        max-width: 820px;
        margin-bottom: 1.25rem;
    }

    .cv-toolbar-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 0.6rem 1.2rem;
        background-color: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--border-radius-md);
        backdrop-filter: blur(10px);
    }

    .cv-toolbar-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .cv-format-badge {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: var(--accent-color);
        background-color: var(--bg-tertiary);
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        border: 1px solid var(--border-color);
    }

    /* Standard Single-Page Clean CV Paper Styles */
    .standard-cv-paper {
        width: 100%;
        max-width: 820px;
        background-color: #ffffff;
        color: #111111;
        font-family: 'Times New Roman', Times, Georgia, serif;
        padding: 38px 45px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        border-radius: 2px;
        box-sizing: border-box;
        line-height: 1.3;
        font-size: 10pt;
    }

    /* Header */
    .hcv-header {
        text-align: center;
        margin-bottom: 14px;
    }

    .hcv-name {
        font-size: 18pt;
        font-weight: bold;
        letter-spacing: 1.2px;
        color: #000000;
        margin: 0 0 2px 0;
        text-transform: uppercase;
        font-family: 'Times New Roman', Times, Georgia, serif;
    }

    .hcv-title {
        font-size: 10.5pt;
        font-style: italic;
        color: #333333;
        margin: 0 0 4px 0;
    }

    .hcv-contact-line {
        font-size: 9pt;
        color: #333333;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
    }

    .hcv-sep {
        color: #666666;
    }

    .hcv-link {
        color: #111111;
        text-decoration: none;
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        cursor: pointer;
    }

    .hcv-link:hover {
        text-decoration: underline;
    }

    /* Sections */
    .hcv-section {
        margin-bottom: 11px;
    }

    .hcv-section-title {
        font-size: 10pt;
        font-weight: bold;
        text-transform: uppercase;
        color: #000000;
        border-bottom: 1px solid #000000;
        padding-bottom: 1px;
        margin: 0 0 6px 0;
        letter-spacing: 0.8px;
    }

    /* Entries */
    .hcv-entry {
        margin-bottom: 6px;
    }

    .hcv-entry-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }

    .hcv-bold {
        font-weight: bold;
        color: #000000;
    }

    .hcv-italic {
        font-style: italic;
        color: #222222;
    }

    .hcv-muted {
        color: #444444;
        font-size: 9pt;
    }

    .hcv-right {
        text-align: right;
        font-size: 9.5pt;
    }

    .hcv-bullets {
        margin: 2px 0 0 16px;
        padding: 0;
        list-style-type: disc;
    }

    .hcv-bullets li {
        margin-bottom: 1.5px;
        font-size: 9.5pt;
        color: #222222;
        text-align: justify;
    }

    .hcv-projects-compact p {
        margin: 0 0 3px 0;
        font-size: 9.5pt;
        color: #222222;
    }

    .hcv-skills-grid p {
        margin: 0 0 3px 0;
        font-size: 9.5pt;
        color: #222222;
    }

    /* =========================================================================
       PRINT STYLESHEET - STRICT 1-PAGE A4 FIT
       ========================================================================= */
    @media print {
        body, html {
            background: #ffffff !important;
            color: #000000 !important;
            margin: 0 !important;
            padding: 0 !important;
            height: 100% !important;
        }

        .no-print,
        .main-header,
        .main-footer,
        .custom-cursor,
        .cursor-follower,
        .toast-container {
            display: none !important;
        }

        .cv-page-wrapper {
            padding: 0 !important;
            margin: 0 !important;
            background: transparent !important;
        }

        .standard-cv-paper {
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
            box-shadow: none !important;
            border: none !important;
            font-size: 9pt !important;
            line-height: 1.22 !important;
        }

        .hcv-header {
            margin-bottom: 8px !important;
        }

        .hcv-name {
            font-size: 15pt !important;
            margin: 0 0 1px 0 !important;
        }

        .hcv-title {
            font-size: 9.5pt !important;
            margin: 0 0 2px 0 !important;
        }

        .hcv-contact-line {
            font-size: 8.5pt !important;
            gap: 4px !important;
        }

        .hcv-section {
            margin-bottom: 7px !important;
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        .hcv-section-title {
            font-size: 9pt !important;
            margin: 0 0 3px 0 !important;
            padding-bottom: 1px !important;
        }

        .hcv-entry {
            margin-bottom: 3.5px !important;
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        .hcv-entry-row {
            font-size: 9pt !important;
        }

        .hcv-right {
            font-size: 8.5pt !important;
        }

        .hcv-bullets {
            margin: 1px 0 0 14px !important;
        }

        .hcv-bullets li {
            margin-bottom: 1px !important;
            font-size: 8.5pt !important;
            line-height: 1.2 !important;
        }

        .hcv-projects-compact p {
            margin: 0 0 2px 0 !important;
            font-size: 8.5pt !important;
            line-height: 1.2 !important;
        }

        .hcv-skills-grid p {
            margin: 0 0 2px 0 !important;
            font-size: 8.5pt !important;
            line-height: 1.2 !important;
        }

        .protected-trigger-btn {
            border: none !important;
            background: none !important;
            box-shadow: none !important;
            color: #111111 !important;
            font-size: inherit !important;
            padding: 0 !important;
        }

        @page {
            margin: 8mm 10mm;
            size: A4 portrait;
        }
    }

    @media (max-width: 768px) {
        .standard-cv-paper {
            padding: 22px 18px;
            font-size: 9pt;
        }
        .hcv-entry-row {
            flex-direction: column;
            gap: 1px;
        }
        .hcv-right {
            text-align: left;
        }
    }
</style>
