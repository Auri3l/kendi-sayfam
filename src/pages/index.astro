---
import Layout from '../layouts/Layout.astro';
import ExperienceCard from '../components/profile/ExperienceCard.astro';
import ProjectCard from '../components/profile/ProjectCard.astro';
import { PROFILE_DATA } from '../data/profileData';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<Layout activePage="home">
    <main>
        <!-- Hero Section -->
        <section id="hero" class="hero-section">
            <div class="hero-bg-grid"></div>
            <div class="container hero-container">
                <div class="hero-content">
                    <span class="hero-badge">
                        <span class="lang-tr">PORTFOLYO &amp; ÖZGEÇMİŞ</span>
                        <span class="lang-en">PORTFOLIO &amp; RESUME</span>
                    </span>
                    <h1 class="hero-title">Ata Yiğit Telli</h1>
                    <h2 class="hero-subtitle">
                        <span class="lang-tr">İnşaat Mühendisi &amp; Proje Yöneticisi</span>
                        <span class="lang-en">Civil Engineer &amp; Project Manager</span>
                    </h2>
                    <p class="hero-lead">
                        <span class="lang-tr">Büyük ölçekli üstyapı ve cephe projelerinde 10 yılı aşkın süredir şantiye şefliği, teknik ofis koordinasyonu, hakediş ve sözleşme yönetimi yürütmekteyim.</span>
                        <span class="lang-en">Over 10 years of engineering leadership in high-rise building and commercial facade projects, specializing in site management, technical office coordination, progress billing, and contract administration.</span>
                    </p>
                    
                    <!-- Quick Contact Buttons -->
                    <div class="hero-cta-group">
                        <a href={`${base}iletisim/`} class="btn btn-primary">
                            <span class="lang-tr">İletişime Geç</span>
                            <span class="lang-en">Get in Touch</span>
                        </a>
                        <a href="https://www.linkedin.com/in/ay-t" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-icon" id="linkedinLink">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                            </svg>
                            <span>LinkedIn</span>
                        </a>
                    </div>
                </div>

                <!-- Hero Meta Card (Architectural Title Block) -->
                <div class="hero-meta-card">
                    <div class="meta-card-inner">
                        <div class="meta-item">
                            <span class="meta-label">
                                <span class="lang-tr">01. Telefon</span>
                                <span class="lang-en">01. Phone</span>
                            </span>
                            <div id="heroPhoneSlot" class="protected-slot">
                                <button type="button" class="protected-trigger-btn" data-action="unlockContact" title="Telefon Numarasını Şifre İle Aç">
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="1" ry="1"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                    <span>•••••••••• (<span class="lang-tr">Şifreli</span><span class="lang-en">Protected</span>)</span>
                                </button>
                            </div>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">
                                <span class="lang-tr">02. E-posta</span>
                                <span class="lang-en">02. Email</span>
                            </span>
                            <a href="mailto:ytelli@gmail.com" class="meta-value">ytelli@gmail.com</a>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">
                                <span class="lang-tr">03. Konum / Merkez</span>
                                <span class="lang-en">03. Location</span>
                            </span>
                            <div id="heroAddressSlot" class="protected-slot">
                                <button type="button" class="protected-trigger-btn" data-action="unlockContact" title="Adresi Şifre İle Aç">
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="1" ry="1"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                    <span>•••••••••• (<span class="lang-tr">Şifreli</span><span class="lang-en">Protected</span>)</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="scroll-indicator" aria-hidden="true">
                <span class="mouse-icon"><span class="wheel"></span></span>
                <span class="scroll-text">
                    <span class="lang-tr">Aşağı</span>
                    <span class="lang-en">Scroll</span>
                </span>
            </div>
        </section>

        <!-- Hakkımda (CV) Section -->
        <section id="hakkimda" class="section section-padding">
            <div class="container">
                <div class="section-header">
                    <span class="section-tag">01 / PROFILE</span>
                    <h3 class="section-title">
                        <span class="lang-tr">Hakkımda &amp; Yetkinlikler</span>
                        <span class="lang-en">About &amp; Core Competencies</span>
                    </h3>
                    <div class="section-divider"></div>
                </div>

                <!-- Summary Grid -->
                <div class="summary-grid">
                    <div class="summary-text-block">
                        <div class="lang-tr">
                            <p>
                                Okan Üniversitesi İngilizce İnşaat Mühendisliği lisans ve İstanbul Gedik Üniversitesi İş Sağlığı ve Güvenliği yüksek lisans mezunuyum. Şantiye operasyonları, teknik ofis süreçleri ve taşeron sözleşme yönetimi alanlarında görev almaktayım.
                            </p>
                            <p>
                                Saha sorumluluğu ve proje şefliği görevlerimde; ana müteahhit iş programına uyum, saha ekiplerinin sevk ve idaresi, teknik şartnamelere ve sözleşmelere uygunluk kontrollerini titizlikle yönettim.
                            </p>
                        </div>
                        <div class="lang-en">
                            <p>
                                Graduated with a B.Sc. in Civil Engineering (100% English curriculum) from Okan University and an M.Sc. in Occupational Health and Safety from Istanbul Gedik University. Specializing in site supervision, technical office management, and subcontractor contract administration.
                            </p>
                            <p>
                                Throughout my roles as Site Manager and Technical Office Leader, I have overseen general contractor schedule integration, site crew coordination, quality assurance, and compliance with technical specifications and FIDIC contracts.
                            </p>
                        </div>
                        <div style="margin-top: 1.75rem;">
                            <a href={`${base}cv/`} class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                                <span class="lang-tr">Özgeçmiş / CV (Tek Sayfa A4 PDF)</span>
                                <span class="lang-en">Resume / CV (Single Page A4 PDF)</span>
                            </a>
                        </div>
                    </div>

                    <!-- Counter Stats -->
                    <div class="stats-container">
                        <div class="stat-card full-width">
                            <span class="stat-number" id="statTotalYrs">10+</span>
                            <span class="stat-label">
                                <span class="lang-tr">Yıl Proje &amp; Saha Deneyimi</span>
                                <span class="lang-en">Years Project &amp; Site Experience</span>
                            </span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" id="statFacadeYrs">9</span>
                            <span class="stat-label">
                                <span class="lang-tr">Yıl Cephe Mühendisliği</span>
                                <span class="lang-en">Years Facade Engineering</span>
                            </span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" id="statProjects">6+</span>
                            <span class="stat-label">
                                <span class="lang-tr">Büyük Referans Proje</span>
                                <span class="lang-en">Major Reference Projects</span>
                            </span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" id="statAcademic">2</span>
                            <span class="stat-label">
                                <span class="lang-tr">Akademik Derece (Lisans + Y.L.)</span>
                                <span class="lang-en">Academic Degrees (B.Sc. + M.Sc.)</span>
                            </span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" id="statLanguages">6</span>
                            <span class="stat-label">
                                <span class="lang-tr">Konuşulan Yabancı Dil</span>
                                <span class="lang-en">Languages Spoken</span>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Mesleki Deneyim -->
                <div class="cv-sub-section">
                    <h4 class="sub-section-title">
                        <span class="lang-tr">Mesleki Deneyim</span>
                        <span class="lang-en">Professional Experience</span>
                    </h4>
                    
                    <!-- Segmented Filters -->
                    <div class="timeline-filters" role="group" aria-label="Deneyim Filtreleri">
                        <button class="filter-btn active" data-filter="all">
                            <span class="lang-tr">Tüm Deneyim</span>
                            <span class="lang-en">All Experience</span>
                        </button>
                        <button class="filter-btn" data-filter="cephe">
                            <span class="lang-tr">Cephe İşleri</span>
                            <span class="lang-en">Facade Engineering</span>
                        </button>
                        <button class="filter-btn" data-filter="yonetim">
                            <span class="lang-tr">Sözleşme &amp; Yönetim</span>
                            <span class="lang-en">Contracts &amp; PM</span>
                        </button>
                        <button class="filter-btn" data-filter="saha">
                            <span class="lang-tr">Saha &amp; Uygulama</span>
                            <span class="lang-en">Site &amp; Execution</span>
                        </button>
                    </div>

                    <!-- Dynamic Timeline Container -->
                    <div class="timeline-container" id="timelineContainer">
                        {PROFILE_DATA.experiences.map((exp, idx) => (
                            <ExperienceCard
                                role={exp.role}
                                roleEn={exp.roleEn}
                                company={exp.company}
                                period={exp.period}
                                periodEn={exp.periodEn}
                                location={exp.location}
                                locationEn={exp.locationEn}
                                categories={exp.categories}
                                description={exp.description}
                                descriptionEn={exp.descriptionEn}
                                details={exp.details}
                                detailsEn={exp.detailsEn}
                                subRoles={exp.subRoles}
                                tags={exp.tags}
                                tagsEn={exp.tagsEn}
                                idx={idx}
                            />
                        ))}
                    </div>
                </div>

                <!-- Yetkinlikler & Diller -->
                <div class="cv-sub-section">
                    <div class="skills-languages-grid">
                        <div class="skills-panel">
                            <h4 class="sub-section-title">
                                <span class="lang-tr">Uzmanlık Alanları</span>
                                <span class="lang-en">Core Competencies</span>
                            </h4>
                            <div class="skills-list" id="skillsList">
                                {PROFILE_DATA.skills.map(sk => (
                                    <div class="skill-item">
                                        <div class="skill-info">
                                            <span class="skill-name lang-tr">{sk.name}</span>
                                            <span class="skill-name lang-en">{sk.nameEn}</span>
                                            <span class="skill-percentage">{sk.level}%</span>
                                        </div>
                                        <div class="skill-bar-bg">
                                            <div class="skill-bar-fill" data-level={sk.level}></div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                        <div class="languages-panel">
                            <h4 class="sub-section-title">
                                <span class="lang-tr">Dil Yetkinlikleri</span>
                                <span class="lang-en">Languages</span>
                            </h4>
                            <div class="languages-list" id="languagesList">
                                {PROFILE_DATA.languages.map(lang => (
                                    <div class="language-card" style={`--lang-percent: ${lang.percent}%`}>
                                        <span class="language-name lang-tr">{lang.name}</span>
                                        <span class="language-name lang-en">{lang.nameEn}</span>
                                        <span class="language-level lang-tr">{lang.level}</span>
                                        <span class="language-level lang-en">{lang.levelEn}</span>
                                        <div class="language-bar"></div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Eğitim Geçmişi -->
                <div class="cv-sub-section">
                    <h4 class="sub-section-title education-title-center">
                        <span class="lang-tr">Eğitim Geçmişi</span>
                        <span class="lang-en">Education History</span>
                    </h4>
                    <div class="education-grid" id="educationGrid">
                        {PROFILE_DATA.education.map(edu => (
                            <div class="education-card">
                                <span class="education-date lang-tr">{edu.date}</span>
                                <span class="education-date lang-en">{edu.dateEn}</span>
                                <h5 class="education-degree lang-tr">{edu.degree}</h5>
                                <h5 class="education-degree lang-en">{edu.degreeEn}</h5>
                                <span class="education-school lang-tr">{edu.school}</span>
                                <span class="education-school lang-en">{edu.schoolEn}</span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- Projeler Section -->
        <section id="projeler" class="section section-padding section-alt">
            <div class="container">
                <div class="section-header">
                    <span class="section-tag">02 / PROJECTS</span>
                    <h3 class="section-title">
                        <span class="lang-tr">Referans Projeler</span>
                        <span class="lang-en">Featured Projects</span>
                    </h3>
                    <div class="section-divider"></div>
                </div>

                <!-- Project Category Filters -->
                <div class="project-filters" role="group" aria-label="Proje Filtreleri">
                    <button class="project-filter-btn active" data-proj-filter="all">
                        <span class="lang-tr">Tüm Projeler</span>
                        <span class="lang-en">All Projects</span>
                    </button>
                    <button class="project-filter-btn" data-proj-filter="us">
                        <span class="lang-tr">ABD (İmalat &amp; Tasarım)</span>
                        <span class="lang-en">USA (Fab &amp; Design)</span>
                    </button>
                    <button class="project-filter-btn" data-proj-filter="tr">
                        <span class="lang-tr">Türkiye Projeleri</span>
                        <span class="lang-en">Turkey Projects</span>
                    </button>
                    <button class="project-filter-btn" data-proj-filter="facade">
                        <span class="lang-tr">Cephe Tasarımı</span>
                        <span class="lang-en">Facade Systems</span>
                    </button>
                </div>

                <!-- Projects Grid -->
                <div class="projects-grid" id="projectsGrid">
                    {PROFILE_DATA.projects.map((proj, idx) => (
                        <ProjectCard
                            title={proj.title}
                            location={proj.location}
                            locationEn={proj.locationEn}
                            category={proj.category}
                            facadeType={proj.facadeType}
                            facadeTypeEn={proj.facadeTypeEn}
                            description={proj.description}
                            descriptionEn={proj.descriptionEn}
                            tags={proj.tags}
                            tagsEn={proj.tagsEn}
                            idx={idx}
                        />
                    ))}
                </div>
            </div>
        </section>
    </main>
</Layout>
