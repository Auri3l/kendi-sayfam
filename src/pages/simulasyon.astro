---
import Layout from '../layouts/Layout.astro';
import MaliyetAraci from '../components/araclar/MaliyetAraci.astro';
import HavaAraci from '../components/araclar/HavaAraci.astro';
import DonatiAraci from '../components/araclar/DonatiAraci.astro';
import '../styles/tools.css';
---

<Layout
    title="Şantiye Araçları | Ata Yiğit Telli"
    activePage="simulasyon"
    description="Konut projeleri için yaklaşık maliyet ve metraj hesabı, 7 günlük şantiye hava ve iş planı, donatı metrajı ve 12 m kesim planı."
>
    <main lang="tr" id="main-content" tabindex="-1">
        <section class="tools-section">
            <div class="container">
                <header class="tools-head">
                    <span class="section-tag">Şantiye araçları</span>
                    <h1 class="tools-title">Şantiyede işe yarayan hesaplar</h1>
                    <p class="tools-lead">Konut projesinin yaklaşık maliyetini birkaç bilgiyle çıkarın, önümüzdeki haftanın hangi günlerinin beton dökümü ve vinç işine uygun olduğunu görün, donatı listesini en az fireyle 12 metrelik çubuklara yerleştirin.</p>
                </header>

                <div class="tools-tabs" role="tablist" aria-label="Araçlar">
                    <button type="button" role="tab" id="tab-maliyet" data-arac-tab="maliyet" aria-controls="panel-maliyet" aria-selected="true">
                        <strong>Yaklaşık maliyet</strong><small>Metraj ve birim fiyat</small>
                    </button>
                    <button type="button" role="tab" id="tab-hava" data-arac-tab="hava" aria-controls="panel-hava" aria-selected="false" tabindex="-1">
                        <strong>Hava ve iş planı</strong><small>7 günlük uygunluk</small>
                    </button>
                    <button type="button" role="tab" id="tab-donati" data-arac-tab="donati" aria-controls="panel-donati" aria-selected="false" tabindex="-1">
                        <strong>Donatı ve kesim</strong><small>Metraj ve 12 m plan</small>
                    </button>
                </div>

                <MaliyetAraci />
                <HavaAraci />
                <DonatiAraci />
            </div>
        </section>
    </main>
</Layout>

<script src="../scripts/araclar.js"></script>
