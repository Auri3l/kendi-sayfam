---
interface Props {
    title: string;
    location: string;
    locationEn?: string;
    category: string;
    facadeType: string;
    facadeTypeEn?: string;
    description: string;
    descriptionEn?: string;
    tags?: string[];
    tagsEn?: string[];
    idx?: number;
}

const {
    title,
    location,
    locationEn = location,
    category,
    facadeType,
    facadeTypeEn = facadeType,
    description,
    descriptionEn = description,
    tags = [],
    tagsEn = tags,
    idx = 0
} = Astro.props;

const tagsStr = tags.join(' ');
const isUS = category === 'us';
---

<div class="project-card reveal" data-category={category} data-tags={tagsStr} style={`animation-delay: ${idx * 0.1}s`}>
    <div>
        <div class="project-header">
            <div class="project-icon" aria-hidden="true">
                {isUS ? (
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                ) : (
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" stroke-linecap="round"/>
                        <path d="M9 3v18M21 9H3M21 15H3" stroke-linecap="round"/>
                    </svg>
                )}
            </div>
            <span class="project-loc-tag lang-tr">{location}</span>
            <span class="project-loc-tag lang-en">{locationEn}</span>
        </div>
        <h4 class="project-title">{title}</h4>
        <p class="project-desc lang-tr">{description}</p>
        <p class="project-desc lang-en">{descriptionEn}</p>
    </div>
    <div class="project-footer">
        <span class="project-tech lang-tr">{facadeType}</span>
        <span class="project-tech lang-en">{facadeTypeEn}</span>
        {tags && tags.length > 0 && (
            <div class="timeline-tags lang-tr">
                {tags.map(t => <span class="tag">{t}</span>)}
            </div>
        )}
        {tagsEn && tagsEn.length > 0 && (
            <div class="timeline-tags lang-en">
                {tagsEn.map(t => <span class="tag">{t}</span>)}
            </div>
        )}
    </div>
</div>
