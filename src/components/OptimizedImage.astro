---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    src: string;
    alt: string;
    sizes?: string;
    priority?: boolean;
    class?: string;
}

const { src, alt, sizes = '(max-width: 768px) 100vw, 768px', priority = false, class: className } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../public/images/*', { eager: true });
const image = images[`../../public/${src}`]?.default;
if (!image) throw new Error(`Missing local image: ${src}`);
---

<Image src={image} alt={alt} widths={[480, 768, 1024]} sizes={sizes}
    format="webp" quality={78} loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'} decoding="async" class={className} />

<style>
    img { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
