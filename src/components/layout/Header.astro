---
interface Props {
    activePage?: string;
    base: string;
}

const { activePage = 'home', base } = Astro.props;
---

<header class="main-header">
    <div class="header-container">
        <a href={base} class="logo-monogram" aria-label="Ana Sayfa / Home">
            <span>AYT</span>
        </a>
        
        <nav class="nav-menu" id="navMenu" aria-label="Ana Gezinti Menüsü">
            <ul>
                <li>
                    <a href={`${base}#hakkimda`} class={`nav-link ${activePage === 'home' ? 'active' : ''}`}>
                        <span class="lang-tr">Hakkımda</span>
                        <span class="lang-en">About</span>
                    </a>
                </li>
                <li><a href={`${base}cv/`} class={`nav-link ${activePage === 'cv' ? 'active' : ''}`}>CV</a></li>
                <li>
                    <a href={`${base}#projeler`} class="nav-link">
                        <span class="lang-tr">Projeler</span>
                        <span class="lang-en">Projects</span>
                    </a>
                </li>
                <li>
                    <a href={`${base}simulasyon/`} class={`nav-link ${activePage === 'simulasyon' ? 'active' : ''}`}>
                        <span class="lang-tr">Simülatör</span>
                        <span class="lang-en">Simulator</span>
                    </a>
                </li>
                <li><a href={`${base}blog/`} class={`nav-link ${activePage === 'blog' ? 'active' : ''}`}>Blog</a></li>
                <li>
                    <a href={`${base}iletisim/`} class={`nav-link ${activePage === 'iletisim' ? 'active' : ''}`}>
                        <span class="lang-tr">İletişim</span>
                        <span class="lang-en">Contact</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="header-actions">
            <!-- Prominent Segmented Language Switcher (TR / EN) -->
            <div class="header-lang-switch" role="group" aria-label="Dil Seçimi / Language Selection">
                <svg class="lang-globe-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <button type="button" class="lang-btn active" data-lang-target="tr" title="Türkçe">TR</button>
                <span class="lang-divider">|</span>
                <button type="button" class="lang-btn" data-lang-target="en" title="English">EN</button>
            </div>

            <!-- Theme Switcher Button -->
            <button id="themeToggle" class="theme-toggle-btn" aria-label="Temayı Değiştir" title="Endüstriyel Açık / Endüstriyel Koyu Temalar Arasında Geçiş Yap">
                <svg class="sun-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="2"/>
                    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <svg class="moon-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                </svg>
            </button>
            
            <!-- Mobile Navigation Toggle -->
            <button id="mobileNavToggle" class="mobile-nav-toggle" aria-label="Menüyü Aç/Kapat" aria-expanded="false" aria-controls="navMenu">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </div>
    </div>
</header>
