---
// Şap, yalıtım ve seramik — hesaplar src/scripts/metraj-core.js içinde
---

<div class="sim-tab-panel" id="tab-sap" role="tabpanel">
    <p class="metraj-intro">Şap alanı tüm katların toplamıdır. Islak hacimlerde zemin, duvar diplerindeki yalıtım şeridi ve duş alanlarında 2,10 m yüksekliğe kadar iki duvar yalıtılır; duvar seramiğinden ıslak hacim kapıları düşülür.</p>
    <div class="metraj-grid">
        <div class="metraj-controls-panel sim-glass-card">
            <h4 class="metraj-panel-title">Girdiler</h4>
            <div class="m-form">
                <fieldset class="m-group">
                    <legend>Şap</legend>
                    <label class="m-field">
                        <span class="m-label">Şap alanı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="1600" class="sim-number-input" data-mmod="sap" data-mkey="sapAlani" /><span class="m-unit">m²</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Şap kalınlığı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.5" value="5" class="sim-number-input" data-mmod="sap" data-mkey="sapKalinlik" /><span class="m-unit">cm</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Çimento dozajı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="10" value="350" class="sim-number-input" data-mmod="sap" data-mkey="dozaj" /><span class="m-unit">kg/m³</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Şap firesi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.5" value="5" class="sim-number-input" data-mmod="sap" data-mkey="fireSap" /><span class="m-unit">%</span></span>
                    </label>
                </fieldset>
                <fieldset class="m-group">
                    <legend>Islak hacim yalıtımı</legend>
                    <label class="m-field">
                        <span class="m-label">Islak hacim zemin alanı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="240" class="sim-number-input" data-mmod="sap" data-mkey="islakZemin" /><span class="m-unit">m²</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Islak hacim duvar çevresi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="420" class="sim-number-input" data-mmod="sap" data-mkey="islakCevre" /><span class="m-unit">m</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Duvarda yalıtım yüksekliği</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.05" value="0.3" class="sim-number-input" data-mmod="sap" data-mkey="yalitimYukseklik" /><span class="m-unit">m</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Duş / küvet sayısı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="30" class="sim-number-input" data-mmod="sap" data-mkey="dusAdet" /><span class="m-unit">adet</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Yalıtım sarfiyatı (kat başı)</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.1" value="1.5" class="sim-number-input" data-mmod="sap" data-mkey="yalitimSarfiyat" /><span class="m-unit">kg/m²</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Yalıtım kat sayısı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="1" step="1" value="2" class="sim-number-input" data-mmod="sap" data-mkey="yalitimKat" /><span class="m-unit">kat</span></span>
                    </label>
                </fieldset>
                <fieldset class="m-group">
                    <legend>Seramik</legend>
                    <label class="m-field">
                        <span class="m-label">Zemin seramiği alanı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="320" class="sim-number-input" data-mmod="sap" data-mkey="zeminSeramik" /><span class="m-unit">m²</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Duvar seramiği yüksekliği</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.05" value="2.4" class="sim-number-input" data-mmod="sap" data-mkey="duvarSeramikH" /><span class="m-unit">m</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Islak hacim kapı adedi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="40" class="sim-number-input" data-mmod="sap" data-mkey="islakKapi" /><span class="m-unit">adet</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Seramik firesi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.5" value="8" class="sim-number-input" data-mmod="sap" data-mkey="fireSeramik" /><span class="m-unit">%</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Yapıştırıcı sarfiyatı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.5" value="5" class="sim-number-input" data-mmod="sap" data-mkey="yapistiriciKg" /><span class="m-unit">kg/m²</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Derz sarfiyatı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.05" value="0.3" class="sim-number-input" data-mmod="sap" data-mkey="derzKg" /><span class="m-unit">kg/m²</span></span>
                    </label>
                </fieldset>
            </div>
        </div>
        <div class="metraj-table-panel sim-glass-card">
            <div class="metraj-table-header">
                <h4 class="metraj-panel-title">Şap, yalıtım ve seramik maliyet cetveli</h4>
                <div class="metraj-actions">
                    <button type="button" class="btn btn-secondary btn-sm" data-metraj-csv="sap">CSV İndir</button>
                    <button type="button" class="btn btn-primary btn-sm btn-open-report-modal" data-module="sap" data-table="table-sap">Rapor (PDF)</button>
                </div>
            </div>
            <div class="metraj-table-wrapper">
                <table class="metraj-table metraj-cost-table" id="table-sap">
                    <thead>
                        <tr>
                            <th scope="col">Poz</th>
                            <th scope="col">İmalat</th>
                            <th scope="col">Miktar</th>
                            <th scope="col">Birim</th>
                            <th scope="col">Birim Fiyat (₺)</th>
                            <th scope="col">Tutar (₺)</th>
                        </tr>
                    </thead>
                    <tbody data-metraj-body></tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5">Ara toplam (KDV hariç)</td>
                            <td data-metraj-sum>—</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="metraj-note">Birim fiyatlar örnek değerdir; hücreye tıklayıp kendi tedarikçi fiyatınızı girin. Girdiğiniz fiyatlar bu tarayıcıda saklanır ve tüm sekmelerde geçerlidir.</p>
            <h5 class="metraj-sub-title">Metraj dökümü</h5>
            <div class="metraj-breakdown" data-metraj-breakdown></div>
        </div>
    </div>
</div>
