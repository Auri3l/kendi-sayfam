---
---

<div class="sim-tab-panel" id="tab-sap" role="tabpanel" aria-labelledby="tab-sap-btn">
    <div class="metraj-grid">
        <div class="metraj-controls-panel sim-glass-card">
            <h4 class="metraj-panel-title">Şap, İzolasyon &amp; Seramik Girdileri</h4>
            <div class="sim-controls-wrapper">
                <div class="sim-control-group">
                    <div class="sim-control-label-row">
                        <span class="sim-control-label">Islak Hacim Zemin Alanı</span>
                        <span class="sim-control-value" id="inpWetAreaVal">35 m²</span>
                    </div>
                    <input type="range" id="inpWetArea" min="5" max="150" value="35" class="sim-range-input" aria-label="Islak Hacim Zemin Alanı" />
                </div>
                <div class="sim-control-group">
                    <div class="sim-control-label-row">
                        <span class="sim-control-label">Zemin Çevresi (Pah Bandı İçin)</span>
                        <span class="sim-control-value" id="inpWetPerimeterVal">24 m</span>
                    </div>
                    <input type="range" id="inpWetPerimeter" min="4" max="80" value="24" class="sim-range-input" aria-label="Zemin Çevresi" />
                </div>
                <div class="sim-control-group">
                    <div class="sim-control-label-row">
                        <span class="sim-control-label">Dökülecek Şap Kalınlığı</span>
                        <span class="sim-control-value" id="inpScreedThkVal">5.0 cm</span>
                    </div>
                    <input type="range" id="inpScreedThk" min="2.0" max="8.0" step="0.5" value="5.0" class="sim-range-input" aria-label="Şap Kalınlığı" />
                </div>
                <div class="sim-control-group">
                    <label class="sim-control-label" for="inpScreedGrade">Şap Çimento Dozaj Sınıfı</label>
                    <select id="inpScreedGrade" class="sim-select">
                        <option value="300">300 kg Çimento / m³ Sand (Hafif Şap)</option>
                        <option value="350" selected>350 kg Çimento / m³ Sand (Standart Şantiye Şapı)</option>
                    </select>
                </div>
                <div class="sim-control-group">
                    <div class="sim-control-label-row">
                        <span class="sim-control-label">Duvar Yalıtım Yüksekliği (Zeminden)</span>
                        <span class="sim-control-value" id="inpIsoHeightVal">1.20 m</span>
                    </div>
                    <input type="range" id="inpIsoHeight" min="0.2" max="2.2" step="0.10" value="1.2" class="sim-range-input" aria-label="Duvar Yalıtım Yüksekliği" />
                </div>
                <div class="sim-control-group">
                    <label class="sim-control-label" for="inpTileSize">Seçilen Seramik Boyutları</label>
                    <select id="inpTileSize" class="sim-select">
                        <option value="3060">30 x 60 cm Seramik</option>
                        <option value="6060" selected>60 x 60 cm Seramik</option>
                        <option value="6012">60 x 120 cm Seramik</option>
                    </select>
                </div>
                <div class="sim-control-group">
                    <label class="sim-control-label" for="inpIsoCoats">Yalıtım Katı Sayısı (Sürme Yalıtım)</label>
                    <input type="number" id="inpIsoCoats" value="2" min="1" max="3" class="sim-select" style="padding:0.5rem;" />
                </div>
                <div class="sim-control-group">
                    <label class="sim-control-label" for="inpTileWaste">Seramik Fire Kayıp Oranı (%)</label>
                    <input type="number" id="inpTileWaste" value="8" min="2" max="20" class="sim-select" style="padding:0.5rem;" />
                </div>

                <button type="button" class="btn btn-primary calc-btn btn-full" id="btnCalcSap">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M8 11h8M12 7v8"/></svg>
                    <span>Şap &amp; Seramik Metrajını Hesapla</span>
                </button>
            </div>
        </div>
        <div class="metraj-table-panel sim-glass-card">
            <div class="metraj-table-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.85rem;">
                <h4 class="metraj-panel-title" style="margin: 0; border: none; padding: 0;">Şap, İzolasyon &amp; Seramik Metraj Cetveli</h4>
                <div class="metraj-actions" style="display: flex; gap: 0.5rem;">
                    <button type="button" class="btn btn-secondary btn-sm btn-export-csv" data-target="table-sap" data-filename="Sap_Yalitim_Metraj_Cetveli">
                        <span>CSV İndir</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm btn-print-pdf">
                        <span>Yazdır</span>
                    </button>
                </div>
            </div>
            <div class="metraj-table-wrapper">
                <table class="metraj-table" id="table-sap">
                    <thead>
                        <tr>
                            <th scope="col">Poz No</th>
                            <th scope="col">İmalat &amp; Malzeme Kalemi</th>
                            <th scope="col">Metraj Miktarı</th>
                            <th scope="col">Birim</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>S-01</td><td>Toplam Şap Hacmi</td><td id="outScreedVol">-</td><td>m³</td></tr>
                        <tr><td>S-02</td><td>Şap İçin Çimento Miktarı (50kg Torba)</td><td id="outScreedCement">-</td><td>Torba</td></tr>
                        <tr><td>S-03</td><td>Şap Kumu İhtiyacı (0-3 mm Şap Kumu)</td><td id="outScreedSand">-</td><td>m³</td></tr>
                        <tr><td>S-04</td><td>Zemin Çatlak Önleyici Çelik Çelik Hasır / Elyaf</td><td id="outScreedMesh">-</td><td>m²</td></tr>
                        <tr><td>S-05</td><td>Duvar Yalıtım Sürme Yüzey Alanı</td><td id="outWallIsoArea">-</td><td>m²</td></tr>
                        <tr><td>S-06</td><td>Toplam Sürme Su Yalıtım Alanı</td><td id="outTotalIsoArea">-</td><td>m²</td></tr>
                        <tr><td>S-07</td><td>Çift Komponentli Sürme İzolasyon Malzemesi (20kg Kova)</td><td id="outIsoLiquidBucket">-</td><td>Kova</td></tr>
                        <tr><td>S-08</td><td>Elastik Pah Bandı Metrajı</td><td id="outPahBandLen">-</td><td>mt</td></tr>
                        <tr><td>S-09</td><td>Süzgeç &amp; Boru Dibi Yalıtım Manşeti</td><td id="outMansetCount">-</td><td>Adet</td></tr>
                        <tr><td>S-10</td><td>Net Zemin &amp; Duvar Seramik Alanı</td><td id="outNetTileArea">-</td><td>m²</td></tr>
                        <tr><td>S-11</td><td>Fire Dahil Sipariş Edilecek Seramik Metrajı</td><td id="outGrossTileArea">-</td><td>m²</td></tr>
                        <tr><td>S-12</td><td>Gerekli Seramik Paket / Kutu Sayısı</td><td id="outTileBoxCount">-</td><td>Kutu</td></tr>
                        <tr><td>S-13</td><td>Seramik Yapıştırma Harcı (C2TE Sınıfı 25kg Torba)</td><td id="outTileAdhesiveBags">-</td><td>Torba</td></tr>
                        <tr><td>S-14</td><td>Antibakteriyel Derz Dolgusu (20kg Torba)</td><td id="outGroutBags">-</td><td>Torba</td></tr>
                        <tr><td>S-15</td><td>Yeniden Kullanılabilir Seviye Tespit Takozu &amp; Klips</td><td id="outTileClipCount">-</td><td>Adet</td></tr>
                        <tr><td>S-16</td><td>Silikonik Islak Hacim Köşe Derz Mastiği (310ml Kartuş)</td><td id="outMastikCount">-</td><td>Adet</td></tr>
                        <tr><td>S-17</td><td>Yalıtım Altı Aderans Artırıcı Astar (Primer)</td><td id="outPrimerKg">-</td><td>kg</td></tr>
                        <tr><td>S-18</td><td>Kritik Nokta File Takviyesi (Alkali Dayanımlı)</td><td id="outIsoMeshLen">-</td><td>m²</td></tr>
                        <tr><td>S-19</td><td>Zemin Seramik / Parke Geçiş Alüminyum Kot Profili</td><td id="outProfLen">-</td><td>mt</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
