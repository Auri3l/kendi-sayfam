---
// SimulationTabsNav.astro - Kategorize Edilmiş Temiz Navigasyon
---

<div class="sim-nav-wrapper">
    <!-- Ana Kategori Segment Switcher -->
    <div class="sim-category-nav" role="group" aria-label="Simülasyon Ana Kategorileri">
        <button type="button" class="sim-cat-btn active" data-category="tools" id="catBtnTools" aria-pressed="true">
            <span class="cat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></span>
            <div class="cat-text-group">
                <span class="cat-title">Mühendislik &amp; İSG Araçları</span>
                <span class="cat-sub">3D FEM, Hava Radarı, Karşılaştırıcı, Donatı</span>
            </div>
            <span class="cat-count">4 Araç</span>
        </button>
        
        <button type="button" class="sim-cat-btn" data-category="metraj" id="catBtnMetraj" aria-pressed="false">
            <span class="cat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="11" x2="10" y2="11"/><line x1="14" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="10" y2="15"/><line x1="14" y1="15" x2="16" y2="15"/><line x1="8" y1="19" x2="16" y2="19"/></svg></span>
            <div class="cat-text-group">
                <span class="cat-title">Metraj &amp; Maliyet</span>
                <span class="cat-sub">Betonarme, duvar, şap-seramik, cephe ve özet</span>
            </div>
            <span class="cat-count">5 Sekme</span>
        </button>
    </div>

    <!-- Kategori 1: Mühendislik & Analiz Araçları Butonları -->
    <div class="sim-tabs-group" id="group-tools" role="tablist" aria-label="Mühendislik araçları">
        <button class="sim-tab-btn active" data-tab="fem" role="tab" aria-selected="true" aria-controls="tab-fem">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2 12 22"/><line x1="2" y1="17" x2="12" y2="22"/><line x1="22" y1="17" x2="12" y2="22"/><line x1="2" y1="12" x2="12" y2="17"/><line x1="22" y1="12" x2="12" y2="17"/></svg>
            3D FEM Cam &amp; Rüzgar Analizi
        </button>
        <button class="sim-tab-btn" data-tab="radar" role="tab" aria-selected="false" aria-controls="tab-radar">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 10 10"/><path d="M12 12l7-7"/></svg>
            Şantiye Hava Radarı &amp; İSG
        </button>
        <button class="sim-tab-btn" data-tab="karsilastirma" role="tab" aria-selected="false" aria-controls="tab-karsilastirma">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            Malzeme &amp; Sistem Karşılaştırıcı
        </button>
        <button class="sim-tab-btn" data-tab="donati-hesap" role="tab" aria-selected="false" aria-controls="tab-donati-hesap">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="16" y2="14"/></svg>
            Donatı, Profil &amp; Kesim Hesabı
        </button>
    </div>

    <!-- Kategori 2: Metraj & Maliyet -->
    <div class="sim-tabs-group" id="group-metraj" role="tablist" aria-label="Metraj ve maliyet" style="display: none;">
        <button class="sim-tab-btn" data-tab="beton" role="tab" aria-selected="false" aria-controls="tab-beton">Betonarme</button>
        <button class="sim-tab-btn" data-tab="duvar" role="tab" aria-selected="false" aria-controls="tab-duvar">Duvar &amp; Sıva</button>
        <button class="sim-tab-btn" data-tab="sap" role="tab" aria-selected="false" aria-controls="tab-sap">Şap, Yalıtım &amp; Seramik</button>
        <button class="sim-tab-btn" data-tab="cephe" role="tab" aria-selected="false" aria-controls="tab-cephe">Cephe</button>
        <button class="sim-tab-btn sim-tab-btn-accent" data-tab="maliyet" role="tab" aria-selected="false" aria-controls="tab-maliyet">Maliyet Özeti</button>
    </div>
</div>
