---
// SimulationTabsNav.astro - Kategorize Edilmiş Temiz Navigasyon
---

<div class="sim-nav-wrapper">
    <!-- Ana Kategori Segment Switcher -->
    <div class="sim-category-nav" role="tablist" aria-label="Simülasyon Ana Kategorileri">
        <button type="button" class="sim-cat-btn active" data-category="tools" id="catBtnTools">
            <span class="cat-icon">🔬</span>
            <div class="cat-text-group">
                <span class="cat-title">Mühendislik &amp; İSG Araçları</span>
                <span class="cat-sub">3D FEM, Hava Radarı, Karşılaştırıcı, Donatı</span>
            </div>
            <span class="cat-count">4 Araç</span>
        </button>
        
        <button type="button" class="sim-cat-btn" data-category="metraj" id="catBtnMetraj">
            <span class="cat-icon">📋</span>
            <div class="cat-text-group">
                <span class="cat-title">Şantiye Metraj Motorları</span>
                <span class="cat-sub">Cephe, Beton-Kalıp, Duvar, Şap &amp; İzolasyon</span>
            </div>
            <span class="cat-count">4 Cetvel (50 Poz)</span>
        </button>
    </div>

    <!-- Kategori 1: Mühendislik & Analiz Araçları Butonları -->
    <div class="sim-tabs-group" id="group-tools">
        <button class="sim-tab-btn active" data-tab="fem" role="tab" aria-selected="true" aria-controls="tab-fem">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2 12 22"/><line x1="2" y1="17" x2="12" y2="22"/><line x1="22" y1="17" x2="12" y2="22"/><line x1="2" y1="12" x2="12" y2="17"/><line x1="22" y1="12" x2="12" y2="17"/></svg>
            3D FEM Cam &amp; Rüzgar Analizi
        </button>
        <button class="sim-tab-btn" data-tab="radar" role="tab" aria-selected="false" aria-controls="tab-radar">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 10 10"/><path d="M12 12l7-7"/></svg>
            ⚡ Şantiye Hava Radarı &amp; İSG
        </button>
        <button class="sim-tab-btn" data-tab="karsilastirma" role="tab" aria-selected="false" aria-controls="tab-karsilastirma">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            ⚖️ Malzeme &amp; Sistem Karşılaştırıcı
        </button>
        <button class="sim-tab-btn" data-tab="donati-hesap" role="tab" aria-selected="false" aria-controls="tab-donati-hesap">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="16" y2="14"/></svg>
            🧮 Donatı, Profil &amp; Kesim Hesabı
        </button>
    </div>

    <!-- Kategori 2: Metraj Cetvelleri Butonları -->
    <div class="sim-tabs-group" id="group-metraj" style="display: none;">
        <button class="sim-tab-btn" data-tab="cephe" role="tab" aria-selected="false" aria-controls="tab-cephe">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/></svg>
            🏢 Cephe Metraj Cetveli (10 Poz)
        </button>
        <button class="sim-tab-btn" data-tab="beton" role="tab" aria-selected="false" aria-controls="tab-beton">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            🏗️ Beton &amp; Kalıp Metrajı (10 Poz)
        </button>
        <button class="sim-tab-btn" data-tab="duvar" role="tab" aria-selected="false" aria-controls="tab-duvar">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 9v12M15 3v6M9 3v6M15 15v6"/></svg>
            🧱 Duvar &amp; Sıva Metrajı (11 Poz)
        </button>
        <button class="sim-tab-btn" data-tab="sap" role="tab" aria-selected="false" aria-controls="tab-sap">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M8 11h8M12 7v8"/></svg>
            💧 Şap, İzolasyon &amp; Seramik (19 Poz)
        </button>
    </div>
</div>
