---
// Cephe metraj ve maliyet — hesaplar src/scripts/metraj-core.js içinde
---

<div class="sim-tab-panel" id="tab-cephe" role="tabpanel">
    <p class="metraj-intro">Konut projelerinde en yaygın çözüm olan mantolama (ETICS) ile giydirme cephe arasında seçim yapın. Mantolamada boşluk oranı kadar alan düşülür ve cephe iskelesi eklenir; giydirme cephede panel modülüne göre profil, cam ve bağlantı elemanı hesaplanır.</p>
    <div class="metraj-grid">
        <div class="metraj-controls-panel sim-glass-card">
            <h4 class="metraj-panel-title">Girdiler</h4>
            <div class="m-form">
                <fieldset class="m-group">
                    <legend>Cephe</legend>
                    <label class="m-field m-field-full">
                        <span class="m-label">Cephe sistemi</span>
                        <select class="sim-select" data-mmod="cephe" data-mkey="sistem"><option value="mantolama" selected>Mantolama (ETICS)</option><option value="giydirme">Alüminyum giydirme cephe</option></select>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Bina dış çevresi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="85" class="sim-number-input" data-mmod="cephe" data-mkey="cepheCevre" /><span class="m-unit">m</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Cephe yüksekliği</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.5" value="16" class="sim-number-input" data-mmod="cephe" data-mkey="binaYukseklik" /><span class="m-unit">m</span></span>
                    </label>
                </fieldset>
                <fieldset class="m-group" data-cephe-sistem="mantolama">
                    <legend>Mantolama</legend>
                    <label class="m-field">
                        <span class="m-label">Pencere/boşluk oranı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="20" class="sim-number-input" data-mmod="cephe" data-mkey="boslukOrani" /><span class="m-unit">%</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Cephedeki pencere adedi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="80" class="sim-number-input" data-mmod="cephe" data-mkey="pencereAdet" /><span class="m-unit">adet</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Bina köşe sayısı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="4" class="sim-number-input" data-mmod="cephe" data-mkey="binaKose" /><span class="m-unit">adet</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Levha kalınlığı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="5" class="sim-number-input" data-mmod="cephe" data-mkey="levhaKalinlik" /><span class="m-unit">cm</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Levha firesi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.5" value="5" class="sim-number-input" data-mmod="cephe" data-mkey="fireLevha" /><span class="m-unit">%</span></span>
                    </label>
                </fieldset>
                <fieldset class="m-group" data-cephe-sistem="giydirme">
                    <legend>Giydirme cephe</legend>
                    <label class="m-field">
                        <span class="m-label">Panel genişliği</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.05" value="1.5" class="sim-number-input" data-mmod="cephe" data-mkey="panelGenislik" /><span class="m-unit">m</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Panel yüksekliği</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.05" value="3.2" class="sim-number-input" data-mmod="cephe" data-mkey="panelYukseklik" /><span class="m-unit">m</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Toplam cam kalınlığı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="20" class="sim-number-input" data-mmod="cephe" data-mkey="camKalinlik" /><span class="m-unit">mm</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Dikme profil ağırlığı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.1" value="4.2" class="sim-number-input" data-mmod="cephe" data-mkey="mullionKg" /><span class="m-unit">kg/m</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Kayıt profil ağırlığı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.1" value="3.1" class="sim-number-input" data-mmod="cephe" data-mkey="transomKg" /><span class="m-unit">kg/m</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Alüminyum firesi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.5" value="5" class="sim-number-input" data-mmod="cephe" data-mkey="fireAlu" /><span class="m-unit">%</span></span>
                    </label>
                </fieldset>
            </div>
        </div>
        <div class="metraj-table-panel sim-glass-card">
            <div class="metraj-table-header">
                <h4 class="metraj-panel-title">Cephe metraj ve maliyet cetveli</h4>
                <div class="metraj-actions">
                    <button type="button" class="btn btn-secondary btn-sm" data-metraj-csv="cephe">CSV İndir</button>
                    <button type="button" class="btn btn-primary btn-sm btn-open-report-modal" data-module="cephe" data-table="table-cephe">Rapor (PDF)</button>
                </div>
            </div>
            <div class="metraj-table-wrapper">
                <table class="metraj-table metraj-cost-table" id="table-cephe">
                    <thead>
                        <tr>
                            <th scope="col">Poz</th>
                            <th scope="col">İmalat</th>
                            <th scope="col">Miktar</th>
                            <th scope="col">Birim</th>
                            <th scope="col">Birim Fiyat (₺)</th>
                            <th scope="col">Tutar (₺)</th>
                        </tr>
                    </thead>
                    <tbody data-metraj-body></tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5">Ara toplam (KDV hariç)</td>
                            <td data-metraj-sum>—</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="metraj-note">Birim fiyatlar örnek değerdir; hücreye tıklayıp kendi tedarikçi fiyatınızı girin. Girdiğiniz fiyatlar bu tarayıcıda saklanır ve tüm sekmelerde geçerlidir.</p>
            <h5 class="metraj-sub-title">Metraj dökümü</h5>
            <div class="metraj-breakdown" data-metraj-breakdown></div>
        </div>
    </div>
</div>
