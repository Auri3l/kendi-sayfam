---
// EngineeringReportModal.astro - Resmi Şantiye & Metraj Hesap Raporu (A4 PDF / Antetli Baskı)
---

<!-- 1. Ekran Üzerindeki Rapor Ayar Modalı -->
<div class="modal-overlay hidden" id="reportConfigModal" role="dialog" aria-modal="true" aria-labelledby="reportModalTitle">
    <div class="modal-box report-modal-box">
        <div class="modal-header">
            <div class="modal-title-row">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
                <h3 class="modal-title" id="reportModalTitle">Resmi Şantiye &amp; Metraj Raporu Hazırla</h3>
            </div>
            <button type="button" class="modal-close-btn" id="closeReportModal" aria-label="Kapat">&times;</button>
        </div>

        <div class="modal-body">
            <p class="modal-desc">
                Hesaplanan metraj tablosunu antetli, standart kodlarını içeren ve imzalanabilir tek sayfa A4 mühendislik raporu olarak PDF formatında kaydedin veya yazdırın.
            </p>

            <form id="reportConfigForm" class="modal-form">
                <div class="form-row-2">
                    <div class="modal-field-group">
                        <label for="repProjectName" class="modal-field-label">Proje Adı</label>
                        <input type="text" id="repProjectName" class="modal-input" value="Maslak Kule Projesi" required />
                    </div>
                    <div class="modal-field-group">
                        <label for="repClient" class="modal-field-label">İşveren / Yüklenici</label>
                        <input type="text" id="repClient" class="modal-input" value="Ana Yüklenici / Şantiye Şefliği" />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="modal-field-group">
                        <label for="repDocNo" class="modal-field-label">Rapor / Revizyon No</label>
                        <input type="text" id="repDocNo" class="modal-input" value="REV-01 / KEŞİF ÖN METRAJI" />
                    </div>
                    <div class="modal-field-group">
                        <label for="repDate" class="modal-field-label">Tarih</label>
                        <input type="date" id="repDate" class="modal-input" />
                    </div>
                </div>

                <div class="modal-field-group">
                    <label for="repNotes" class="modal-field-label">Şantiye Teknik Notu / Açıklama</label>
                    <input type="text" id="repNotes" class="modal-input" value="İmalat öncesi teknik şartnameye uygunluk ve yaklaşık keşif miktarlarıdır." />
                </div>

                <div class="modal-actions-row">
                    <button type="button" class="btn btn-secondary" id="btnCancelReport">İptal</button>
                    <button type="submit" class="btn btn-primary" id="btnGenerateAndPrint">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <polyline points="6 9 6 2 18 2 18 9"></polyline>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                            <rect x="6" y="14" width="12" height="8"></rect>
                        </svg>
                        <span>A4 PDF Oluştur &amp; Yazdır</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 2. Sadece Yazdırma (Print) Esnasında Görünen A4 Pafta Antetli Rapor Şablonu -->
<div class="print-only-sheet" id="engineeringReportSheet" aria-hidden="true">
    <!-- Antet Başlığı (Blueprint Title Block) -->
    <header class="sheet-title-block">
        <div class="sheet-header-top">
            <div class="sheet-brand">
                <span class="sheet-logo-mono">AYT</span>
                <div class="sheet-brand-text">
                    <h2 class="sheet-firm-title">ATA YİĞİT TELLİ • MÜHENDİSLİK &amp; TEKNİK OFİS DANIŞMANLIĞI</h2>
                    <span class="sheet-firm-sub">İnşaat Mühendisliği • Şantiye Koordinasyonu • Hakediş &amp; Sözleşme Yönetimi</span>
                </div>
            </div>
            <div class="sheet-report-meta">
                <div class="meta-line"><span>DOKÜMAN:</span> <strong id="sheetDocNo">REV-01</strong></div>
                <div class="meta-line"><span>TARİH:</span> <strong id="sheetDate">-</strong></div>
                <div class="meta-line"><span>SAYFA:</span> <strong>1 / 1</strong></div>
            </div>
        </div>

        <div class="sheet-header-divider"></div>

        <div class="sheet-project-grid">
            <div class="sheet-proj-cell">
                <span class="cell-lbl">PROJE ADI:</span>
                <strong class="cell-val" id="sheetProjectName">Merkez Kule Projesi</strong>
            </div>
            <div class="sheet-proj-cell">
                <span class="cell-lbl">İŞVEREN / MÜTEAHHİT:</span>
                <strong class="cell-val" id="sheetClient">Teknik Ofis Şefliği</strong>
            </div>
            <div class="sheet-proj-cell">
                <span class="cell-lbl">HESAP MODÜLÜ:</span>
                <strong class="cell-val" id="sheetModuleName">Metraj Cetveli</strong>
            </div>
            <div class="sheet-proj-cell">
                <span class="cell-lbl">TEKNİK STANDARTLAR:</span>
                <strong class="cell-val" id="sheetStandardCode">TS EN 13830 / TS 500</strong>
            </div>
        </div>
    </header>

    <!-- Rapor Ana Başlığı ve Notu -->
    <div class="sheet-body-intro">
        <h2 class="sheet-main-title" id="sheetReportTitle">İMALAT MALZEME METRAJ CETVELİ VE POZ LİSTESİ</h2>
        <p class="sheet-notes-text" id="sheetNotesText">İmalat öncesi teknik şartnameye uygunluk ve yaklaşık keşif miktarlarıdır.</p>
    </div>

    <!-- Metraj Tablosu Konteyneri (JS tarafından canlı klonlanır) -->
    <div class="sheet-table-wrapper" id="sheetTableContainer">
        <!-- Dinamik tablo yerleşimi -->
    </div>

    <!-- Resmi İmza ve Onay Bloğu (Signature Block) -->
    <footer class="sheet-footer-block">
        <div class="sheet-signatures-grid">
            <div class="sig-box">
                <span class="sig-role">HAZIRLAYAN (PREPARED BY)</span>
                <div class="sig-space"></div>
                <strong class="sig-name">Ata Yiğit Telli</strong>
                <span class="sig-title">İnşaat Mühendisi</span>
            </div>
            <div class="sig-box">
                <span class="sig-role">KONTROL EDEN (CHECKED BY)</span>
                <div class="sig-space"></div>
                <strong class="sig-name">Teknik Ofis Şefi</strong>
                <span class="sig-title">Metraj &amp; Hakediş Mühendisliği</span>
            </div>
            <div class="sig-box">
                <span class="sig-role">ONAYLAYAN (APPROVED BY)</span>
                <div class="sig-space"></div>
                <strong class="sig-name">Proje Müdürü</strong>
                <span class="sig-title">Şantiye Genel Koordinatörü</span>
            </div>
        </div>

        <div class="sheet-footer-footnote">
            <span>Bu resmi metraj ve hesaplama raporu Ata Yiğit Telli İnteraktif Mühendislik Simülasyon Laboratuvarı üzerinden üretilmiştir.</span>
            <span>https://auri3l.github.io/kendi-sayfam</span>
        </div>
    </footer>
</div>
