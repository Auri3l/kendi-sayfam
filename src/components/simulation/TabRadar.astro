---
// TabRadar.astro - Şantiye Hava Radarı & İmalat Uygunluk Karar Motoru
---

<div id="tab-radar" class="sim-tab-pane" role="tabpanel" aria-labelledby="tab-radar-btn">
    <div class="sim-grid-container">
        <!-- Sol Kontrol Paneli: Şantiye Hava Durumu Parametreleri -->
        <div class="sim-panel sim-glass-card">
            <div class="panel-header">
                <span class="panel-tag">İklim &amp; İSG Kriterleri</span>
                <h4 class="panel-title">Şantiye Hava &amp; Ortam Koşulları</h4>
            </div>

            <!-- Hazır Şantiye Senaryoları -->
            <div class="sim-input-group">
                <label class="sim-label">Hızlı Senaryo Seçimi</label>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <button type="button" class="btn btn-secondary btn-sm" id="btnPresetNormal" style="font-size: 0.75rem;">☀️ Normal Bahar/Yaz</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnPresetStorm" style="font-size: 0.75rem;">💨 Fırtınalı Gün</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnPresetCold" style="font-size: 0.75rem;">❄️ Don / Soğuk Kış</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnPresetRain" style="font-size: 0.75rem;">🌧️ Şiddetli Yağmur</button>
                </div>
            </div>

            <!-- Sıcaklık -->
            <div class="sim-input-group">
                <div class="label-with-val">
                    <label for="radarTemp" class="sim-label">Ortam Sıcaklığı</label>
                    <span id="valRadarTemp" class="slider-display-badge">18 °C</span>
                </div>
                <input type="range" id="radarTemp" min="-10" max="45" step="1" value="18" class="sim-slider" />
                <span class="field-hint">TS 500 beton döküm sınırı: +5°C ile +32°C arasıdır.</span>
            </div>

            <!-- Rüzgar Hızı -->
            <div class="sim-input-group">
                <div class="label-with-val">
                    <label for="radarWind" class="sim-label">Rüzgar Hızı (Anlık Esinti)</label>
                    <span id="valRadarWind" class="slider-display-badge">15 km/h</span>
                </div>
                <input type="range" id="radarWind" min="0" max="90" step="1" value="15" class="sim-slider" />
                <span class="field-hint">İSG Kuralı: 45 km/h üzeri rüzgarda vinç ve sepet operasyonu durdurulur.</span>
            </div>

            <!-- Bağıl Nem -->
            <div class="sim-input-group">
                <div class="label-with-val">
                    <label for="radarHumidity" class="sim-label">Bağıl Nem Oranı</label>
                    <span id="valRadarHumidity" class="slider-display-badge">55 %</span>
                </div>
                <input type="range" id="radarHumidity" min="10" max="100" step="5" value="55" class="sim-slider" />
                <span class="field-hint">%80 üzeri nemde dış cephe silikonu ve boya kurumaz.</span>
            </div>

            <!-- Yağış Durumu -->
            <div class="sim-input-group">
                <label for="radarPrecip" class="sim-label">Hava Durumu &amp; Yağış</label>
                <select id="radarPrecip" class="sim-select">
                    <option value="clear" selected>Açık / Güneşli</option>
                    <option value="cloudy">Parçalı Bulutlu (Kuru)</option>
                    <option value="light_rain">Hafif Çisenti</option>
                    <option value="heavy_rain">Şiddetli Yağmur / Sağanak</option>
                    <option value="snow">Kar Yağışı / Don</option>
                </select>
            </div>
        </div>

        <!-- Sağ Sonuç Paneli: İmalat Karar Matrisi -->
        <div class="sim-panel sim-glass-card">
            <div class="panel-header">
                <span class="panel-tag">Canlı İSG &amp; Kalite Kontrol</span>
                <h4 class="panel-title">Şantiye İmalat Karar Matrisi</h4>
            </div>

            <div class="radar-results-stack" style="display: flex; flex-direction: column; gap: 0.85rem;">
                <!-- 1. Beton Dökümü -->
                <div class="radar-card" id="cardBetonRadar">
                    <div class="radar-card-header">
                        <span class="radar-trade-name">🏗️ Taşıyıcı Sistem Beton Dökümü</span>
                        <span class="radar-badge" id="badgeBeton">UYGUN</span>
                    </div>
                    <p class="radar-desc" id="descBeton">Sıcaklık standart aralıkta (+5°C / +32°C). Normal döküm yapılabilir.</p>
                </div>

                <!-- 2. Kule Vinç & Ağır Kaldırma -->
                <div class="radar-card" id="cardCraneRadar">
                    <div class="radar-card-header">
                        <span class="radar-trade-name">🚜 Kule Vinç &amp; Ağır Kaldırma</span>
                        <span class="radar-badge" id="badgeCrane">GÜVENLİ</span>
                    </div>
                    <p class="radar-desc" id="descCrane">Rüzgar hızı limit altında (< 45 km/h). Vinç operasyonları güvenlidir.</p>
                </div>

                <!-- 3. Dış Cephe Sepeti & İskele -->
                <div class="radar-card" id="cardScaffoldRadar">
                    <div class="radar-card-header">
                        <span class="radar-trade-name">🧗 Asma Sepet &amp; Dış Cephe İskelesi</span>
                        <span class="radar-badge" id="badgeScaffold">GÜVENLİ</span>
                    </div>
                    <p class="radar-desc" id="descScaffold">Yüksekte çalışma için rüzgar ve zemin koşulları elverişli.</p>
                </div>

                <!-- 4. Cephe Silikonu, Mastik & Su Yalıtımı -->
                <div class="radar-card" id="cardSiliconeRadar">
                    <div class="radar-card-header">
                        <span class="radar-trade-name">🧴 Cephe Sosis Silikon &amp; Yalıtım</span>
                        <span class="radar-badge" id="badgeSilicone">UYGUN</span>
                    </div>
                    <p class="radar-desc" id="descSilicone">Yüzey nemi ve sıcaklık fitil/silikon aderansı için uygundur.</p>
                </div>

                <!-- 5. Dış Sıva & Dış Cephe Boyası -->
                <div class="radar-card" id="cardPaintRadar">
                    <div class="radar-card-header">
                        <span class="radar-trade-name">🎨 Dış Cephe Boya, Sıva &amp; Kaplama</span>
                        <span class="radar-badge" id="badgePaint">UYGUN</span>
                    </div>
                    <p class="radar-desc" id="descPaint">Kürlenme ve kuruma şartları normal sınırlarda.</p>
                </div>
            </div>
        </div>
    </div>
</div>
