---
---

<div class="sim-tab-panel" id="tab-duvar" role="tabpanel" aria-labelledby="tab-duvar-btn">
    <div class="metraj-grid">
        <div class="metraj-controls-panel sim-glass-card">
            <h4 class="metraj-panel-title">Duvar &amp; Sıva Parametreleri</h4>
            <div class="sim-controls-wrapper">
                <div class="sim-control-group">
                    <div class="sim-control-label-row">
                        <span class="sim-control-label">Toplam Duvar Uzunluğu</span>
                        <span class="sim-control-value" id="inpWallLenVal">40 m</span>
                    </div>
                    <input type="range" id="inpWallLen" min="5" max="250" value="40" class="sim-range-input" aria-label="Toplam Duvar Uzunluğu" />
                </div>
                <div class="sim-control-group">
                    <div class="sim-control-label-row">
                        <span class="sim-control-label">Kat Yüksekliği (Duvar Yüksekliği)</span>
                        <span class="sim-control-value" id="inpWallHeightVal">3.20 m</span>
                    </div>
                    <input type="range" id="inpWallHeight" min="2.2" max="5.0" step="0.1" value="3.2" class="sim-range-input" aria-label="Kat Yüksekliği" />
                </div>
                <div class="sim-control-group">
                    <label class="sim-control-label" for="inpWallType">Duvar Malzeme Türü</label>
                    <select id="inpWallType" class="sim-select">
                        <option value="brick">Kil Tuğla (19x19x13.5 cm)</option>
                        <option value="ytong" selected>Gazbeton/Ytong (60x25x15 cm)</option>
                        <option value="bims">Bims Blok (39x19x19 cm)</option>
                    </select>
                </div>
                <div class="sim-control-group">
                    <label class="sim-control-label" for="inpOpeningsCount">Kapı ve Pencere Açıklıkları Sayısı (Adet)</label>
                    <input type="number" id="inpOpeningsCount" value="3" class="sim-select" style="padding:0.5rem;" />
                </div>
                <div class="sim-control-group">
                    <div class="sim-control-label-row">
                        <span class="sim-control-label">Sıva Kalınlığı (Tek Yüz)</span>
                        <span class="sim-control-value" id="inpPlasterThkVal">2.0 cm</span>
                    </div>
                    <input type="range" id="inpPlasterThk" min="1.0" max="4.0" step="0.5" value="2.0" class="sim-range-input" aria-label="Sıva Kalınlığı" />
                </div>

                <button type="button" class="btn btn-primary calc-btn btn-full" id="btnCalcDuvar">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="1"/><path d="M3 9h18M3 15h18M9 9v12M15 3v6M9 3v6M15 15v6"/></svg>
                    <span>Duvar &amp; Sıva Metrajını Hesapla</span>
                </button>
            </div>
        </div>
        <div class="metraj-table-panel sim-glass-card">
            <div class="metraj-table-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.85rem;">
                <h4 class="metraj-panel-title" style="margin: 0; border: none; padding: 0;">Duvar ve Sıva Malzemeleri Metraj Cetveli</h4>
                <div class="metraj-actions" style="display: flex; gap: 0.5rem;">
                    <button type="button" class="btn btn-secondary btn-sm btn-export-csv" data-target="table-duvar" data-filename="Duvar_Siva_Metraj_Cetveli">
                        <span>CSV İndir</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm btn-print-pdf">
                        <span>Yazdır</span>
                    </button>
                </div>
            </div>
            <div class="metraj-table-wrapper">
                <table class="metraj-table" id="table-duvar">
                    <thead>
                        <tr>
                            <th scope="col">Poz No</th>
                            <th scope="col">Malzeme Tanımı</th>
                            <th scope="col">Metraj Miktarı</th>
                            <th scope="col">Birim</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>D-01</td><td>Brüt Duvar Yüzey Alanı</td><td id="outGrossWallArea">-</td><td>m²</td></tr>
                        <tr><td>D-02</td><td>Boşluklar Düşülmüş Net Duvar Alanı</td><td id="outNetWallArea">-</td><td>m²</td></tr>
                        <tr><td>D-03</td><td>Gerekli Duvar Blok / Tuğla Sayısı</td><td id="outBlockCount">-</td><td>Adet</td></tr>
                        <tr><td>D-04</td><td>Duvar Palet Sayısı (Şantiye Sevkiyatı)</td><td id="outPalletCount">-</td><td>Palet</td></tr>
                        <tr><td>D-05</td><td>Duvar Örme Harcı / Yapıştırıcı İhtiyacı</td><td id="outMortarAmount">-</td><td>kg</td></tr>
                        <tr><td>D-06</td><td>Çift Yüz Toplam Sıva Alanı</td><td id="outPlasterArea">-</td><td>m²</td></tr>
                        <tr><td>D-07</td><td>Toplam Sıva Harcı Hacmi</td><td id="outPlasterVol">-</td><td>m³</td></tr>
                        <tr><td>D-08</td><td>Sıva İçin Gerekli Torba Çimento (50 kg)</td><td id="outCementBags">-</td><td>Torba</td></tr>
                        <tr><td>D-09</td><td>Sıva Kumu İhtiyacı (0-3 mm)</td><td id="outPlasterSand">-</td><td>m³</td></tr>
                        <tr><td>D-10</td><td>Kapı/Pencere Üstü Hazır Lento Sayısı</td><td id="outLintelCount">-</td><td>Adet</td></tr>
                        <tr><td>D-11</td><td>Köşe Koruma &amp; Donatı Filesi Metrajı</td><td id="outMeshLen">-</td><td>mt</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
