---
// Duvar ve sıva metraj ve maliyet — hesaplar src/scripts/metraj-core.js içinde
---

<div class="sim-tab-panel" id="tab-duvar" role="tabpanel">
    <p class="metraj-intro">Binadaki toplam duvar uzunluğunu ve net yüksekliği girin. Kapı (0,90×2,10 m) ve pencere boşlukları düşülerek net örgü alanı bulunur; sıva, seçilen yüz sayısına göre hesaplanır.</p>
    <div class="metraj-grid">
        <div class="metraj-controls-panel sim-glass-card">
            <h4 class="metraj-panel-title">Girdiler</h4>
            <div class="m-form">
                <fieldset class="m-group">
                    <legend>Duvar</legend>
                    <label class="m-field m-field-full">
                        <span class="m-label">Duvar malzemesi</span>
                        <select class="sim-select" data-mmod="duvar" data-mkey="duvarTipi"><option value="tugla135" selected>Yatay delikli tuğla 19×19×13,5</option><option value="tugla85">Yatay delikli tuğla 19×19×8,5</option><option value="gazbeton">Gazbeton blok 60×25</option><option value="bims">Bims blok 39×19×19</option></select>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Toplam duvar uzunluğu</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="600" class="sim-number-input" data-mmod="duvar" data-mkey="duvarUzunlugu" /><span class="m-unit">m</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Net duvar yüksekliği</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.05" value="2.85" class="sim-number-input" data-mmod="duvar" data-mkey="duvarYuksekligi" /><span class="m-unit">m</span></span>
                    </label>
                </fieldset>
                <fieldset class="m-group">
                    <legend>Boşluklar</legend>
                    <label class="m-field">
                        <span class="m-label">Kapı adedi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="60" class="sim-number-input" data-mmod="duvar" data-mkey="kapiAdet" /><span class="m-unit">adet</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Pencere adedi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="1" value="40" class="sim-number-input" data-mmod="duvar" data-mkey="pencereAdet" /><span class="m-unit">adet</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Ortalama pencere alanı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.1" value="1.8" class="sim-number-input" data-mmod="duvar" data-mkey="pencereAlan" /><span class="m-unit">m²</span></span>
                    </label>
                </fieldset>
                <fieldset class="m-group">
                    <legend>Sıva ve fire</legend>
                    <label class="m-field">
                        <span class="m-label">Sıvanacak yüz sayısı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="1" step="1" value="2" class="sim-number-input" data-mmod="duvar" data-mkey="sivaYuz" /><span class="m-unit">yüz</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Alçı sıva kalınlığı</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.1" value="1.5" class="sim-number-input" data-mmod="duvar" data-mkey="sivaKalinlik" /><span class="m-unit">cm</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Blok firesi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.5" value="5" class="sim-number-input" data-mmod="duvar" data-mkey="fireBlok" /><span class="m-unit">%</span></span>
                    </label>
                    <label class="m-field">
                        <span class="m-label">Sıva firesi</span>
                        <span class="m-input-wrap"><input type="number" inputmode="decimal" min="0" step="0.5" value="5" class="sim-number-input" data-mmod="duvar" data-mkey="fireSiva" /><span class="m-unit">%</span></span>
                    </label>
                </fieldset>
            </div>
        </div>
        <div class="metraj-table-panel sim-glass-card">
            <div class="metraj-table-header">
                <h4 class="metraj-panel-title">Duvar ve sıva metraj ve maliyet cetveli</h4>
                <div class="metraj-actions">
                    <button type="button" class="btn btn-secondary btn-sm" data-metraj-csv="duvar">CSV İndir</button>
                    <button type="button" class="btn btn-primary btn-sm btn-open-report-modal" data-module="duvar" data-table="table-duvar">Rapor (PDF)</button>
                </div>
            </div>
            <div class="metraj-table-wrapper">
                <table class="metraj-table metraj-cost-table" id="table-duvar">
                    <thead>
                        <tr>
                            <th scope="col">Poz</th>
                            <th scope="col">İmalat</th>
                            <th scope="col">Miktar</th>
                            <th scope="col">Birim</th>
                            <th scope="col">Birim Fiyat (₺)</th>
                            <th scope="col">Tutar (₺)</th>
                        </tr>
                    </thead>
                    <tbody data-metraj-body></tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5">Ara toplam (KDV hariç)</td>
                            <td data-metraj-sum>—</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="metraj-note">Birim fiyatlar örnek değerdir; hücreye tıklayıp kendi tedarikçi fiyatınızı girin. Girdiğiniz fiyatlar bu tarayıcıda saklanır ve tüm sekmelerde geçerlidir.</p>
            <h5 class="metraj-sub-title">Metraj dökümü</h5>
            <div class="metraj-breakdown" data-metraj-breakdown></div>
        </div>
    </div>
</div>
