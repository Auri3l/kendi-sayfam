---
import '../styles/global.css';
import '../styles/refinements.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PassphraseModal from '../components/ui/PassphraseModal.astro';

interface Props {
	title?: string;
	description?: string;
	activePage?: string;
	ogImage?: string;
}

const { 
	title = "Ata Yiğit Telli | İnşaat Mühendisi · Şantiye & Proje Yönetimi", 
	description = "Ata Yiğit Telli - İnşaat mühendisi. Şantiye ve proje yönetimi, sözleşme ve hakediş, konut projelerinde uçtan uca yapım yönetimi.",
	activePage = "home",
	ogImage
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://auri3l.github.io');
const resolvedOgImage = ogImage ? new URL(`${base}${ogImage}`, Astro.site || 'https://auri3l.github.io').href : new URL(`${base}images/hero_bg.png`, Astro.site || 'https://auri3l.github.io').href;
---

<!DOCTYPE html>
<html lang="tr" class="dark-theme">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <!-- Canonical & Robots -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Ata Yiğit Telli" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:locale" content="tr_TR" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Favicon & Monogram Icons -->
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Prevent FOUC Theme Flash -->
    <script is:inline>
        (() => {
            let theme, lang;
            try {
                theme = localStorage.getItem('theme');
                lang = localStorage.getItem('user_lang');
            } catch { /* Preferences are optional when storage is unavailable. */ }
            const dark = theme === 'dark-theme' || (theme !== 'light-theme' && matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.classList.toggle('dark-theme', dark);
            document.documentElement.classList.toggle('light-theme', !dark);
            document.documentElement.dataset.lang = lang === 'en' ? 'en' : 'tr';
            document.documentElement.lang = lang === 'en' ? 'en' : 'tr';
        })();
    </script>
</head>
<body>
    <a class="skip-link" href="#main-content"><span class="lang-tr">İçeriğe geç</span><span class="lang-en">Skip to content</span></a>
    <!-- Navigation Header -->
    <Header activePage={activePage} base={base} />

    <!-- Main Content Slot -->
    <slot />

    <!-- Footer -->
    <Footer />

    <!-- Passphrase Modal for Protected Contact Information -->
    <PassphraseModal />

    <!-- Centralized Script -->
    <script src="../scripts/main.js"></script>
</body>
</html>
